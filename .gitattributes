# 默认：所有文本文件用 LF 行尾（仓库存储 + 检出均为 LF）
* text=auto eol=lf

# 文档 / 配置 —— 显式锁定 LF
*.md        text eol=lf
*.txt       text eol=lf
.gitignore  text eol=lf

# Windows 专用脚本 —— 保留 CRLF
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# 二进制文件
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.ico       binary
